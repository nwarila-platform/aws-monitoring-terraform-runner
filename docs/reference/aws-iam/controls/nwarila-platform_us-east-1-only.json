{
  "Statement": [
    {
      "Action": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1"
          ]
        }
      },
      "Effect": "Deny",
      "Resource": "*",
      "Sid": "DenyEveryRegionTheAlertsDoNotWatch"
    }
  ],
  "Version": "2012-10-17"
}
